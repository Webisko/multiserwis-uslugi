APP_NAME="Multiserwis Leads API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=database/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=h108.seohost.pl
MAIL_PORT=465
MAIL_USERNAME=biuro@multiserwis.tech
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="biuro@multiserwis.tech"
MAIL_FROM_NAME="${APP_NAME}"
LEAD_NOTIFICATION_EMAIL="biuro@multiserwis.tech"

MAIL_DEPT_BIURO=biuro@multiserwis.tech
MAIL_DEPT_WYNAJEM=wynajem@multiserwis.tech
MAIL_DEPT_AUTOMATYKA=automatyka@multiserwis.tech
MAIL_DEPT_TECHNOLOGIA=technologia@multiserwis.tech
MAIL_DEPT_SZKOLENIA=szkolenia@multiserwis.tech
MAIL_ALWAYS_CC_OFFICE=false

FRONTEND_URL=http://localhost:3000
FILAMENT_ADMIN_EMAILS=admin@webisko.pl,kamil.kapruziak@multiserwis.tech,justyna.kapruziak@multiserwis.tech,izabela@multiserwis.tech,joanna@multiserwis.tech,technologia@multiserwis.tech
STATIC_PREVIEW_EXPORT_ENABLED=true
FRONTEND_REBUILD_ENABLED=false
FRONTEND_REBUILD_AUTO_DISPATCH=true
FRONTEND_REBUILD_TIMEOUT=10
FRONTEND_REBUILD_GITHUB_REPOSITORY=Webisko/multiserwis-uslugi
FRONTEND_REBUILD_GITHUB_TOKEN=
FRONTEND_REBUILD_GITHUB_EVENT=preview-rebuild

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
