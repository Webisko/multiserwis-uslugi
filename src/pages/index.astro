---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import { Footer } from '../components/Footer';
import { Hero } from '../components/Hero';
import { WhyUsSection } from '../screens/HomePage';
import { ServicesSection } from '../components/ServicesSection';
import { ElectricalSection } from '../components/ElectricalSection';
import { UdtSection } from '../components/UdtSection';
import { CertificatesSection } from '../components/CertificatesSection';
import { FaqSection } from '../components/FaqSection';
import { ContactSection } from '../components/ContactSection';
import { defaultCompany } from '../data/company';
import { getSiteSettings } from '../lib/siteSettings';
import { getSiteContent } from '../lib/siteContent';

const [siteSettings, siteContent] = await Promise.all([getSiteSettings(), getSiteContent()]);
const companyData = siteSettings?.company ?? defaultCompany;
const featuredFaqItems = siteContent.faqs.items
  .filter((item) => item.isFeatured)
  .map((item) => ({ question: item.question, answer: item.answer }));
---

<Layout
  title="Multiserwis Kutno – Wynajem Dźwigów, Relokacje Maszyn, UDT, Spawanie i Elektryka"
  description="Kompleksowe usługi dla przemysłu w Kutnie i całej Polsce: wynajem żurawi (35t–90t) i podestów, relokacje linii produkcyjnych, konserwacja UDT, spawalnictwo, hydraulika i elektryka. Wycena w 24h!"
  preloadHero={true}
  faqItems={featuredFaqItems}
>
  <div>
    <Navbar client:idle companyData={companyData} />
    <main class="flex-grow">
      <Hero companyData={companyData} />
      <WhyUsSection />
      <ServicesSection client:visible services={siteContent.services.items} />
      <ElectricalSection />
      <UdtSection />
      <CertificatesSection />
      <FaqSection client:visible faqGroups={siteContent.faqs.featuredGroups} />
      <ContactSection client:visible serviceOptions={siteContent.services.contactOptions} />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
