---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { ElectricalPage as Screen } from "../screens/ElectricalPage";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
---

<Layout
  title="Usługi Elektryczne, Pomiary i Rozruch Instalacji (nn, SN, WN) | Multiserwis Kutno"
  description="Prace kontrolno-pomiarowe, uruchomienia rozdzielnic nn i SN, integracja AKPiA (Profibus, Profinet, Modbus) oraz wykonawstwo instalacji elektrycznych w przemyśle."
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <Screen client:load companyData={companyData} />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
