---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { WeldingPage as Screen } from "../screens/WeldingPage";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
---

<Layout
  title="Usługi Spawalnicze (TIG, MIG/MAG) i Konstrukcje Stalowe | Multiserwis Kutno"
  description="Mobilne usługi spawalnicze u klienta oraz prefabrykacja i montaż konstrukcji stalowych: antresole, podesty serwisowe, suwnice, ramy, wsporniki i naprawy zbiorników."
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <Screen client:load companyData={companyData} />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
