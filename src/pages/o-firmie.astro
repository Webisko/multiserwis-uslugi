---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { AboutPage as Screen } from "../screens/AboutPage";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
---

<Layout
  title="O Firmie i Certyfikat ISO 9001:2015 (PCA AC 136) | Multiserwis Kutno"
  description="Poznaj Multiserwis Kutno: własny park maszynowy, wielobranżowe brygady techniczne i system zarządzania jakością ISO 9001:2015 potwierdzony akredytacją PCA AC 136."
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <Screen client:load companyData={companyData} />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
