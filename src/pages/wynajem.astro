---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { RentalsPage } from "../screens/RentalsPage";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
---

<Layout
  title="Wynajem Maszyn, Żurawi (30–500 t) i Podnośników | Multiserwis Kutno"
  description="Wynajem żurawi samochodowych (od 30 t do 500 t), podestów ruchomych, podnośników koszowych, ładowarek teleskopowych i wózków widłowych w Kutnie i centralnej Polsce."
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <RentalsPage client:load companyData={companyData} />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
