---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
const basePath = companyData.links.basePath;
---

<Layout
  title="Strona nie została odnaleziona (404) | Multiserwis Kutno"
  description="Błąd 404. Szukana strona nie istnieje. Sprawdź ofertę usług przemysłowych Multiserwis Kutno."
>
  <div class="flex flex-col min-h-screen">
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow pt-32 pb-20 flex items-center justify-center bg-industrial-950">
      <div class="page-container text-center max-w-2xl">
        <div class="mb-6 inline-flex h-20 w-20 items-center justify-center rounded-2xl bg-industrial-900 text-industrial-accent border border-gray-800">
          <span class="text-3xl font-display font-bold">404</span>
        </div>
        <h1 class="section-title mb-4">Strona nie została odnaleziona</h1>
        <p class="text-base sm:text-lg text-gray-300 mb-8 leading-relaxed">
          Szukana podstrona nie istnieje lub jej adres uległ zmianie. Wróć na stronę główną lub
          przejdź bezpośrednio do kontaktu, aby porozmawiać o swoim zleceniu.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`${basePath}/`}
            class="px-7 py-3.5 bg-industrial-accent text-industrial-950 font-bold rounded-lg hover:bg-industrial-accentHover transition-colors text-center"
          >
            Wróć na stronę główną
          </a>
          <a
            href={`${basePath}/kontakt`}
            class="px-7 py-3.5 border border-gray-700 bg-industrial-900 text-white font-semibold rounded-lg hover:border-industrial-accent hover:text-industrial-accent transition-colors text-center"
          >
            Skontaktuj się z nami
          </a>
        </div>
      </div>
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
