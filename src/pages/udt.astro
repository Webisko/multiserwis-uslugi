---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { UdtPage as Screen } from "../screens/UdtPage";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
---

<Layout
  title="Konserwacja UDT, Rejestracja Urządzeń, Resurs i Serwis | Multiserwis Kutno"
  description="Kompleksowa obsługa UDT: rejestracja urządzeń bez dokumentacji, resurs, przeglądy konserwatorskie, naprawa hydrauliki siłowej i serwis wózków, podestów, żurawi HDS oraz suwnic."
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <Screen client:load companyData={companyData} />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
