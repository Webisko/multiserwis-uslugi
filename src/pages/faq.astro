---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { FaqPage as Screen } from "../screens/FaqPage";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";
import { getSiteContent } from "../lib/siteContent";

const [siteSettings, siteContent] = await Promise.all([getSiteSettings(), getSiteContent()]);
const companyData = siteSettings?.company ?? defaultCompany;
const faqSchemaItems = siteContent.faqs.items.map((item) => ({
  question: item.question,
  answer: item.answer,
}));
---

<Layout
  title="Często Zadawane Pytania (FAQ) – Wynajem, UDT, Relokacje | Multiserwis Kutno"
  description="Odpowiedzi na najczęściej zadawane pytania dotyczące wynajmu żurawi i podestów z operatorem, rejestracji i przeglądów UDT, relokacji maszyn oraz prac spawalniczych."
  faqItems={faqSchemaItems}
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <Screen
        client:visible
        companyData={companyData}
        faqItems={siteContent.faqs.items}
        categories={siteContent.faqs.categories}
      />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
