---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { ConstructionPage as Screen } from "../screens/ConstructionPage";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
---

<Layout
  title="Hydraulika Przemysłowa, Rurociągi i Montaż Konstrukcji | Multiserwis Kutno"
  description="Modernizacja i naprawa rurociągów przemysłowych, wymiana armatury, izolacje termiczne oraz konstrukcje wsporcze pod maszyny na czynnych obiektach przemysłowych."
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <Screen client:load companyData={companyData} />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
