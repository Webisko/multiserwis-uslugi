---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { PageHeader } from "../components/PageHeader";
import { ServiceInquiryCta } from "../components/ServiceInquiryCta";
import {
  WeldingTorchIcon,
  UdtHookShieldIcon,
  MachineRelocationIcon,
  IndustrialPipelineIcon,
  SwitchgearPowerIcon,
  CraneTruckIcon,
} from "../components/icons/IndustrialIcons";
import { ArrowRight } from "lucide-react";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
const basePath = companyData.links.basePath;

const techServices = [
  {
    title: "Usługi spawalnicze i konstrukcje",
    desc: "Mobilne naprawy bieżące maszyn i zbiorników oraz prefabrykacja i montaż konstrukcji stalowych, antresol, podestów i suwnic.",
    href: `${basePath}/spawanie`,
    slug: "spawanie",
  },
  {
    title: "Konserwacja, serwis i obsługa UDT",
    desc: "Rejestracja urządzeń (również bez dokumentacji), obliczanie resursu, przeglądy konserwatorskie oraz naprawa hydrauliki siłowej i sterowania.",
    href: `${basePath}/udt`,
    slug: "udt",
  },
  {
    title: "Relokacja maszyn i linii produkcyjnych",
    desc: "Kompleksowe przenoszenie parku maszynowego: demontaż, wyprowadzenie (VersaLift, rolki, żurawie), transport, ustawienie i rozruch.",
    href: `${basePath}/relokacja`,
    slug: "relokacja",
  },
  {
    title: "Hydraulika i montaż przemysłowy",
    desc: "Modernizacja i budowa rurociągów przemysłowych, wymiana armatury, izolacje termiczne oraz konstrukcje wsporcze pod nowe maszyny.",
    href: `${basePath}/budownictwo`,
    slug: "budownictwo",
  },
  {
    title: "Usługi elektryczne i rozruchowe",
    desc: "Pomiary odbiorcze i okresowe, uruchomienia rozdzielnic nn i SN, integracja AKPiA oraz wykonawstwo tras i linii kablowych.",
    href: `${basePath}/elektryka`,
    slug: "elektryka",
  },
  {
    title: "Wynajem maszyn i dźwigów",
    desc: "Własne żurawie samochodowe (35t–90t), podesty ruchome nożycowe i koszowe, ładowarki teleskopowe oraz wózki widłowe.",
    href: `${basePath}/wynajem`,
    slug: "wynajem",
  },
];
---

<Layout
  title="Usługi Techniczne dla Przemysłu – Spawanie, UDT, Relokacje | Multiserwis Kutno"
  description="Kompleksowe usługi techniczne dla zakładów przemysłowych: spawalnictwo i konstrukcje stalowe, relokacja maszyn, konserwacja UDT, hydraulika przemysłowa i elektryka."
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <PageHeader
        badge="Kompleksowe utrzymanie ruchu i inwestycje"
        title="Usługi techniczne dla przemysłu"
        subtitle="W jednym miejscu łączymy spawalnictwo, relokacje maszyn, obsługę UDT, rurociągi przemysłowe i elektrykę z własnym zapleczem dźwigowym."
      />

      <section class="page-section">
        <div class="page-container">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-14">
            {techServices.map((item) => (
              <a
                href={item.href}
                class="group offer-card flex flex-col justify-between hover:-translate-y-1"
              >
                <div>
                  <div class="w-12 h-12 rounded-xl bg-industrial-950 border border-gray-800 flex items-center justify-center text-industrial-accent mb-5 group-hover:bg-industrial-accent group-hover:text-industrial-950 transition-colors">
                    {item.slug === "spawanie" && <WeldingTorchIcon size={24} />}
                    {item.slug === "udt" && <UdtHookShieldIcon size={24} />}
                    {item.slug === "relokacja" && <MachineRelocationIcon size={24} />}
                    {item.slug === "budownictwo" && <IndustrialPipelineIcon size={24} />}
                    {item.slug === "elektryka" && <SwitchgearPowerIcon size={24} />}
                    {item.slug === "wynajem" && <CraneTruckIcon size={24} />}
                  </div>
                  <h2 class="card-title mb-3 group-hover:text-industrial-accent transition-colors">
                    {item.title}
                  </h2>
                  <p class="text-sm sm:text-base text-gray-300 leading-relaxed mb-6">
                    {item.desc}
                  </p>
                </div>
                <div class="pt-4 border-t border-gray-800/70 flex items-center justify-between text-sm font-bold text-industrial-accent group-hover:text-white transition-colors">
                  <span>Przejdź do szczegółów</span>
                  <ArrowRight size={17} className="transition-transform group-hover:translate-x-1" />
                </div>
              </a>
            ))}
          </div>

          <ServiceInquiryCta
            client:visible
            title="Potrzebujesz wsparcia technicznego dopasowanego do konkretnego zadania?"
            description="Napisz, czy chodzi o relokację, spawanie, przygotowanie urządzeń do UDT albo pakiet kilku usług jednocześnie. Przygotujemy właściwy zakres prac i skierujemy zapytanie do odpowiedniego zespołu."
            contactLabel="Skonsultuj zakres prac"
            trainingTitle="Szkolenia branżowe UDT, SEP i spawalnicze"
            trainingDescription="W obszarach UDT, spawalnictwa i energetyki SEP prowadzimy także certyfikowane szkolenia dla pracowników na osobnej domenie szkoleniowej."
            companyData={companyData}
          />
        </div>
      </section>
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
