---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { RelocationPage as Screen } from "../screens/RelocationPage";
import { defaultCompany } from "../data/company";
import { getSiteSettings } from "../lib/siteSettings";

const companyData = (await getSiteSettings())?.company ?? defaultCompany;
---

<Layout
  title="Relokacja Maszyn i Linii Produkcyjnych | Multiserwis Kutno"
  description="Kompleksowa relokacja maszyn i linii technologicznych w Polsce i Europie: demontaż, wyprowadzenie (VersaLift, żurawie do 90t), transport, montaż, poziomowanie i rozruch."
>
  <div>
    <Navbar client:load companyData={companyData} />
    <main class="flex-grow">
      <Screen client:load companyData={companyData} />
    </main>
    <Footer client:visible companyData={companyData} />
  </div>
</Layout>
