---
import { defaultCompany } from '../data/company';
import { getDefaultSeo, getSiteSettings, getEffectiveBasePath } from '../lib/siteSettings';
import UmamiAnalytics from '../components/UmamiAnalytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  preloadHero?: boolean;
  faqItems?: Array<{ question: string; answer: string }>;
}

const { title, description, preloadHero = false, faqItems = [] } = Astro.props;
const siteSettings = await getSiteSettings();
const company = siteSettings?.company ?? {
  ...defaultCompany,
  links: {
    ...defaultCompany.links,
    basePath: getEffectiveBasePath(defaultCompany.links.basePath),
  },
};
const seo = siteSettings?.seo ?? getDefaultSeo();
const pageDescription = description || seo.defaultDescription;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const rawOgImage = seo.ogImageUrl || 'og-image.png';
const isAbsoluteOg = rawOgImage.startsWith('http://') || rawOgImage.startsWith('https://');
const normalizedOgPath = rawOgImage
  .replace(/^https?:\/\/[^\/]+/, '')
  .replace(/^\/multiserwis-uslugi(\/|$)/, '$1')
  .replace(/^\/+/, '');
const effectiveBase = company.links.basePath.replace(/^\/+|\/+$/g, '');
const relativeOgPath = effectiveBase ? `/${effectiveBase}/${normalizedOgPath}` : `/${normalizedOgPath}`;
const ogImageUrl = isAbsoluteOg
  ? rawOgImage
  : Astro.site
    ? new URL(relativeOgPath, Astro.site).toString()
    : `${Astro.url.origin}${relativeOgPath}`;
const websiteUrl = Astro.site
  ? new URL(`${company.links.basePath}/`, Astro.site).toString()
  : `${Astro.url.origin}${company.links.basePath}/`;
const runtimeSettingsScript = siteSettings
  ? `window.__MULTISERWIS_SITE_SETTINGS__ = ${JSON.stringify(siteSettings)};`
  : '';

const graphEntities: Record<string, unknown>[] = [
  {
    '@type': 'LocalBusiness',
    '@id': `${websiteUrl}#organization`,
    name: company.name,
    legalName: 'MULTISERWIS KUTNO SPÓŁKA Z OGRANICZONĄ ODPOWIEDZIALNOŚCIĄ',
    taxID: 'PL7752676330',
    vatID: 'PL7752676330',
    url: websiteUrl,
    email: company.email,
    telephone: company.phones.services.href.replace('tel:', ''),
    image: ogImageUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: company.address.street,
      postalCode: company.address.postalCode,
      addressLocality: company.address.city,
      addressCountry: 'PL',
    },
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '08:00',
        closes: '16:00',
      },
    ],
    sameAs: [company.links.trainingSiteUrl],
    areaServed: 'Polska',
    description: pageDescription,
  },
  {
    '@type': 'WebSite',
    '@id': `${websiteUrl}#website`,
    url: websiteUrl,
    name: company.name,
    description: seo.defaultDescription,
    inLanguage: 'pl-PL',
    publisher: {
      '@id': `${websiteUrl}#organization`,
    },
  },
];

if (faqItems.length > 0) {
  graphEntities.push({
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graphEntities,
};
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${company.links.basePath}/favicon.svg`}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${company.links.basePath}/favicon-32x32.png`}
    />
    <link
      rel="icon"
      type="image/x-icon"
      href={`${company.links.basePath}/favicon.ico`}
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${company.links.basePath}/apple-touch-icon.png`}
    />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta
      property="og:image:type"
      content={ogImageUrl.endsWith('.svg') ? 'image/svg+xml' : 'image/png'}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    {runtimeSettingsScript ? <script is:inline set:html={runtimeSettingsScript}></script> : null}
    {preloadHero ? (
      <>
        <link
          rel="preload"
          as="image"
          href={`${company.links.basePath}/hero-bg-mobile.webp`}
          type="image/webp"
          media="(max-width: 640px)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          href={`${company.links.basePath}/hero-bg.webp`}
          type="image/webp"
          media="(min-width: 641px)"
          fetchpriority="high"
        />
      </>
    ) : null}
    <link rel="llms" href={`${company.links.basePath}/llms.txt`} />
    <meta name="webmcp-tools" content="send_contact_inquiry" />
    <link
      rel="preload"
      href={`${company.links.basePath}/fonts/oswald-700.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${company.links.basePath}/fonts/oswald-700-ext.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style is:inline set:html={`
      @font-face {
        font-family: 'Oswald';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('${company.links.basePath}/fonts/oswald-700-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Oswald';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url('${company.links.basePath}/fonts/oswald-700.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('${company.links.basePath}/fonts/inter-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 700;
        font-display: swap;
        src: url('${company.links.basePath}/fonts/inter.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    `}></style>
    <title>{title}</title>

    <UmamiAnalytics />
  </head>
  <body
    class="min-h-screen bg-industrial-950 text-gray-100 font-sans selection:bg-industrial-accent selection:text-industrial-950 flex flex-col"
  >
    <slot />

    <script is:inline>
      if (typeof window !== 'undefined') {
        const registerWebMCP = async () => {
          const mc = window.modelContext || navigator.modelContext || document.modelContext;
          if (mc && typeof mc.registerTool === 'function') {
            try {
              await mc.registerTool({
                name: 'send_contact_inquiry',
                description:
                  'Wyślij zapytanie ofertowe dotyczące usług przemysłowych (wynajem maszyn, relokacja, UDT, spawanie, elektryka) do Multiserwis Kutno.',
                inputSchema: {
                  type: 'object',
                  properties: {
                    fullName: { type: 'string', description: 'Imię i nazwisko' },
                    phone: { type: 'string', description: 'Numer telefonu' },
                    email: { type: 'string', description: 'Adres e-mail' },
                    service: { type: 'string', description: 'Wybrana usługa' },
                    message: { type: 'string', description: 'Opis prac lub zapytania' },
                  },
                  required: ['fullName', 'email', 'phone', 'message'],
                },
              });
            } catch (e) {
              console.debug('WebMCP registration:', e);
            }
          }
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', registerWebMCP);
        } else {
          registerWebMCP();
        }
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
</style>
