# Cache-Control and Security headers for LiteSpeed / Apache
<IfModule mod_headers.c>
    # Do not cache HTML files - always fetch latest version
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Long-term caching for hashed assets
    <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|webp|avif|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Security headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Prevent directory listings
Options -Indexes

# Block access to hidden files and sensitive configuration files
<FilesMatch "(^\.|\.(env|sqlite|db|log|git|yml|yaml)|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Redirect legacy / preview basePath requests to root
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^multiserwis-uslugi/(.*)$ /$1 [R=301,L]
</IfModule>

# Custom 404 handler
ErrorDocument 404 /404.html
