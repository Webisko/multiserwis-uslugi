APP_NAME="Multiserwis CMS & API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.multiserwis.tech

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/home/srv127364/domains/panel.multiserwis.tech/backend/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=h108.seohost.pl
MAIL_PORT=465
MAIL_USERNAME=biuro@multiserwis.tech
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="biuro@multiserwis.tech"
MAIL_FROM_NAME="Multiserwis Kutno"
LEAD_NOTIFICATION_EMAIL="biuro@multiserwis.tech"

FRONTEND_URL=https://multiserwis.tech
FILAMENT_ADMIN_EMAILS=admin@webisko.pl
STATIC_PREVIEW_EXPORT_ENABLED=false
FRONTEND_REBUILD_ENABLED=false
FRONTEND_REBUILD_AUTO_DISPATCH=true
FRONTEND_REBUILD_TIMEOUT=10
FRONTEND_REBUILD_GITHUB_REPOSITORY=Webisko/multiserwis-uslugi
FRONTEND_REBUILD_GITHUB_TOKEN=
FRONTEND_REBUILD_GITHUB_EVENT=preview-rebuild

VITE_APP_NAME="${APP_NAME}"
