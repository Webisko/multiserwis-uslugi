{
  "name": "multiserwis-uslugi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-dev.mjs",
    "check": "astro check",
    "verify": "npm run check && npm run build",
    "check:ui-pages": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-page-consistency.ps1",
    "smoke:routes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-routes.ps1",
    "perf:baseline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/perf-baseline.ps1",
    "release:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-gate.ps1",
    "build": "node scripts/run-astro-build.mjs preview",
    "build:preview": "node scripts/run-astro-build.mjs preview",
    "build:staging": "node scripts/run-astro-build.mjs staging",
    "build:production": "node scripts/run-astro-build.mjs production",
    "deploy:staging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-staging-seohost.ps1",
    "preview": "astro preview",
    "astro": "astro",
    "backend:serve": "node scripts/run-backend-php.mjs -S 127.0.0.1:8081 -t public",
    "backend:migrate": "node scripts/run-backend-php.mjs artisan migrate",
    "backend:test": "node scripts/run-backend-php.mjs vendor/bin/phpunit",
    "backend:export-preview": "node scripts/run-backend-php.mjs artisan preview:export-snapshots"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.563.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  }
}
